// --------------------------------------------------------
// SENTINEL DATABASE SCHEMA (Production Ready - Enhanced)
// --------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --------------------------------------------------------
// ENUMS (Strict Typing)
// --------------------------------------------------------

enum UserRole {
  SUPER_ADMIN  // The Boss
  CR           // Class Rep (Boys)
  GR           // Girls Rep (Girls)
  GUARD        // Security Personnel
  STUDENT      // The Attendee
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ScanStatus {
  GRANTED      // Green Screen
  REJECTED     // Red Screen (Unpaid/Banned)
  DUPLICATE    // Blue Screen (Passback attempt)
}

enum ScanType {
  ENTRY
  EXIT
}

enum EventStatus {
  DRAFT        // Event not yet published
  PUBLISHED    // Live and accepting registrations
  ACTIVE       // Event day - gates open
  COMPLETED    // Event finished
  CANCELLED    // Event cancelled
}

// --------------------------------------------------------
// MODELS
// --------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete for sync

  // --- IDENTITY ---
  sapId       String  @unique @map("sap_id") // The Primary Identifier (e.g., 70168915)
  fullName    String? @map("full_name")
  email       String? @unique // Unique for Managers/Admins, Nullable for Students
  cnic        String? // Optional initially, mandatory after onboarding
  phoneNumber String? @map("phone_number")
  gender      Gender? // Mandatory for lane routing

  // --- AUTHENTICATION & SECURITY ---
  role            UserRole @default(STUDENT)
  activationToken String?  @unique @map("activation_token") // The 6-char secret for Student Login (Indexed)
  passwordHash    String?  @map("password_hash") // For Admins/CRs only

  // SECURITY: Track failed login attempts for rate limiting
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  lastFailedLogin     DateTime? @map("last_failed_login")
  lockedUntil         DateTime? @map("locked_until")

  // --- STATUS FLAGS ---
  isPaid           Boolean @default(true) @map("is_paid") // Default true as per requirements
  profileCompleted Boolean @default(false) @map("profile_completed")
  isActive         Boolean @default(true)  @map("is_active") // Admin Kill Switch

  // --- METADATA (For Sorting/Filtering) ---
  semester String? // e.g., "8"
  section  String? // e.g., "A"
  department String? // e.g., "BSCS"

  // --- MEDIA (Compressed URLs) ---
  profilePhotoUrl    String? @map("profile_photo_url")
  universityCardUrl  String? @map("university_card_url")

  // --- RELATIONS ---

  // Who created this user? (Financial Audit Trail)
  // If this is a Student, createdBy points to the CR/GR who took the cash.
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("UserCreator", fields: [createdById], references: [id])

  // Who did this user create? (If this user is a CR/GR)
  createdUsers User[]  @relation("UserCreator")

  // Entry Logs (History of scans)
  accessLogs AccessLog[] @relation("UserScans")

  // Scans performed by this user (if Guard/Admin)
  performedScans AccessLog[] @relation("Scanner")

  // Audit Logs (Actions performed by this user)
  auditLogs AuditLog[] @relation("AuditPerformer")

  // --- INDEXES ---
  @@index([sapId])
  @@index([activationToken])
  @@index([role, isActive]) // For "Get All Active Students" queries
  @@index([createdById]) // For "Manager Ledger" lookups
  @@index([isPaid, role]) // For payment filtering
  @@index([createdAt]) // For date-based queries
  @@map("users")
}

model AccessLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  // --- WHO ---
  userId String @map("user_id")
  user   User   @relation("UserScans", fields: [userId], references: [id])

  // --- WHO SCANNED ---
  scannerId String? @map("scanner_id")
  scanner   User?   @relation("Scanner", fields: [scannerId], references: [id])

  // --- RESULT ---
  status ScanStatus
  type   ScanType

  // --- CONTEXT ---
  gateNumber String? @map("gate_number") // "Gate 1", "Female Lane"

  // --- EVENT REFERENCE ---
  eventId String? @map("event_id")
  event   Event?  @relation(fields: [eventId], references: [id])

  // --- METADATA ---
  metadata Json? // Store extra debug info if needed

  @@index([userId])
  @@index([timestamp]) // For "Live Dashboard" queries
  @@index([userId, timestamp]) // Composite for user history
  @@index([eventId, timestamp]) // For event-specific queries
  @@index([status, timestamp]) // For security alerts
  @@map("access_logs")
}

// --------------------------------------------------------
// AUDIT LOG (For Admin Actions - Immutable)
// --------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  performerId String   @map("performer_id") // Who did it?
  performer   User     @relation("AuditPerformer", fields: [performerId], references: [id])

  action    String   // "REVOKE_ACCESS", "FREEZE_CR", "MANUAL_ENTRY"
  targetId  String?  @map("target_id") // Who was affected?
  details   String?  // JSON or Text

  // IP and User Agent for security audit
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  @@index([performerId])
  @@index([targetId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

// --------------------------------------------------------
// SYSTEM SETTINGS (Dynamic Config)
// --------------------------------------------------------

model SystemSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// --------------------------------------------------------
// EVENT (Dynamic Event Configuration)
// --------------------------------------------------------

model Event {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- EVENT DETAILS ---
  name        String           // "CS Annual Dinner 2025"
  venue       String?          // "Royal Palm Golf & Country Club"
  date        DateTime         // Event date
  startTime   DateTime?        @map("start_time")
  endTime     DateTime?        @map("end_time")
  description String?

  // --- BRANDING ---
  logoUrl     String?          @map("logo_url")
  bannerUrl   String?          @map("banner_url")
  primaryColor String?         @map("primary_color") // Hex color

  // --- CAPACITY ---
  maxCapacity Int?             @map("max_capacity")

  // --- STATUS ---
  status      EventStatus      @default(DRAFT)
  isDefault   Boolean          @default(false) @map("is_default") // Current active event

  // --- PRICING ---
  ticketPrice Int              @default(2000) @map("ticket_price")

  // --- RELATIONS ---
  accessLogs  AccessLog[]

  @@index([status])
  @@index([isDefault])
  @@index([date])
  @@map("events")
}
